{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "lib": ["ES2020", "dom"]
  },
  "include": [
    "jest.config.cjs",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**/*.ts",
    "src/**/*.d.ts"
  ]
}
